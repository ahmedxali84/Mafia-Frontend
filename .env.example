# Copy to .env.local for local dev. On Vercel set it in Project > Settings > Environment Variables.
# URL of mafia-backend. Unset = localhost:4000 in dev, https://mafia-backend-z04f.onrender.com in production builds
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
# Discord invite for the "Join our Discord" buttons (menu, home, voice panel, game over).
# Default: the team server https://discord.gg/SCaPFuzkGp (never expires). Set only to use another invite;
# must be https://discord.gg/<code> or https://discord.com/invite/<code>.
NEXT_PUBLIC_DISCORD_URL=
# ── Accounts (week 7): Google login + saved stats. Leave all empty to keep accounts off. ──
# Server-only values (no NEXT_PUBLIC_ prefix). Set them in Vercel > Settings > Environment Variables.
# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials > OAuth client ID, "Web application").
# Authorized redirect URI: https://<your-site>/api/auth/callback/google (and http://localhost:3000/api/auth/callback/google for dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret for the login session cookie: `npx auth secret` or any 32+ random bytes
NEXTAUTH_SECRET=
# Your site's URL (Vercel sets this automatically; needed locally): http://localhost:3000
NEXTAUTH_URL=
# Shared with the game server: MUST be the same value as GAME_TOKEN_SECRET on Render
GAME_TOKEN_SECRET=
